{
  "manifest_version": 2,
  "id": "com.0-hz.maibot-dnd",
  "version": "0.1.1",
  "name": "地下城 (MaiBot D&D)",
  "description": "在群聊中运行带规则裁判的 D&D 式会话：插件负责骰子、属性、物品与回合批处理，独立 GM 智能体负责叙事，麦麦作为报名玩家以自然语言参与。",
  "author": {
    "name": "kes",
    "url": "https://github.com/yufei-pan"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/yufei-pan/maibot-dnd-plugin",
    "homepage": "https://github.com/yufei-pan/maibot-dnd-plugin",
    "documentation": "https://github.com/yufei-pan/maibot-dnd-plugin/blob/main/README.md",
    "issues": "https://github.com/yufei-pan/maibot-dnd-plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "tomli",
      "version_spec": ">=2.0.0"
    },
    {
      "type": "python_package",
      "name": "tomli-w",
      "version_spec": ">=1.0.0"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27.0"
    },
    {
      "type": "python_package",
      "name": "pyyaml",
      "version_spec": ">=6.0.0"
    }
  ],
  "capabilities": [
    "config.get",
    "chat.get_all_streams",
    "llm.generate",
    "send.text",
    "send.image",
    "render.html2png",
    "maisaka.context.append",
    "maisaka.proactive.trigger",
    "person.get_id"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
